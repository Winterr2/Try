-- Core State Logic
local afkEnabled = false
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

-- Configuration Variables
local originalQuality = settings().Rendering.QualityLevel
local originalShadows = Lighting.GlobalShadows

-- Cleaning Engine Function
local function sweepLagObjects()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Explosion") or obj:IsA("Shirt") or obj:IsA("Pants") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        elseif obj:IsA("MeshPart") then
            obj.RenderFidelity = Enum.RenderFidelity.Performance
        end
    end
    for _, sound in ipairs(SoundService:GetDescendants()) do
        if sound:IsA("Sound") then sound.Volume = 0 end
    end
    gcinfo()
    collectgarbage("collect")
end

-- Persistent Loop Background Worker
task.spawn(function()
    while true do
        if afkEnabled then
            sweepLagObjects()
        end
        task.wait(12)
    end
end)

-- GUI Interaction Handler
ToggleBtn.MouseButton1Click:Connect(function()
    afkEnabled = not afkEnabled
    
    if afkEnabled then
        -- Trigger Low-Fidelity AFK State
        ToggleBtn.Text = "DISABLE AFK MODE"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(160, 45, 45)
        StatusLabel.Text = "Status: Max Optimization (15 FPS)"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
        
        RunService:Set3dRenderingEnabled(false)
        setfpscap(15) -- Safe performance restriction that won't break server physics data
        Lighting.GlobalShadows = false
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        sweepLagObjects()
    else
        -- Restore Standard Client Performance State
        ToggleBtn.Text = "ENABLE AFK MODE"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 130, 80)
        StatusLabel.Text = "Status: Rendering Normal"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        
        RunService:Set3dRenderingEnabled(true)
        setfpscap(0) -- Reverts framing controls back to native application standards
        Lighting.GlobalShadows = originalShadows
        settings().Rendering.QualityLevel = originalQuality
    end
end)
