--==================================================
-- TELEPORT
--==================================================

local function teleportToScreenPosition(position)
    if not teleportEnabled then
        return
    end

    if isRecording or isPlaying then
        return
    end

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local ray = Camera:ScreenPointToRay(
        position.X,
        position.Y
    )

    local params = RaycastParams.new()

    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        character
    }

    local result = workspace:Raycast(
        ray.Origin,
        ray.Direction * 2000,
        params
    )

    if result then
        local targetPosition = result.Position

        root.CFrame =
            CFrame.new(
                targetPosition + Vector3.new(0, 3, 0)
            )
    end
end

--==================================================
-- PERFORMANCE MODE
--==================================================

local function enablePerformanceMode()
    performanceEnabled = true

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    for _, object in ipairs(workspace:GetDescendants()) do

        if object:IsA("BasePart") then
            pcall(function()
                object.CastShadow = false
                object.Reflectance = 0
            end)

        elseif object:IsA("ParticleEmitter") then
            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("Trail") then
            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("Beam") then
            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles") then

            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            pcall(function()
                object.Transparency = 1
            end)

        elseif object:IsA("MeshPart") then
            pcall(function()
                object.RenderFidelity =
                    Enum.RenderFidelity.Performance
            end)
        end
    end

    for _, sound in ipairs(SoundService:GetDescendants()) do
        if sound:IsA("Sound") then
            pcall(function()
                sound.Volume = 0
            end)
        end
    end
end

local function disablePerformanceMode()
    performanceEnabled = false

    pcall(function()
        if originalQuality then
            settings().Rendering.QualityLevel =
                originalQuality
        end
    end)

    pcall(function()
        Lighting.GlobalShadows = originalShadows
    end)

    -- We intentionally do NOT attempt to restore every object.
    -- Some games dynamically create effects and restoring them
    -- blindly can cause visual problems.
end

