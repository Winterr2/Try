--==================================================
-- CHARACTER VISUAL HIDER
--==================================================

local hiddenCharacterObjects = {}

local function rememberObject(object)

    if hiddenCharacterObjects[object] then
        return
    end

    if object:IsA("BasePart") then

        hiddenCharacterObjects[object] = {
            Type = "BasePart",
            LocalTransparencyModifier =
                object.LocalTransparencyModifier
        }

    elseif object:IsA("Decal")
        or object:IsA("Texture") then

        hiddenCharacterObjects[object] = {
            Type = "Transparency",
            Transparency =
                object.Transparency
        }

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

        hiddenCharacterObjects[object] = {
            Type = "Enabled",
            Enabled = object.Enabled
        }

    elseif object:IsA("Highlight") then

        hiddenCharacterObjects[object] = {
            Type = "Highlight",
            Enabled = object.Enabled
        }

    elseif object:IsA("BillboardGui")
        or object:IsA("SurfaceGui") then

        hiddenCharacterObjects[object] = {
            Type = "Gui",
            Enabled = object.Enabled
        }

    end
end

--==================================================
-- CHARACTER CHECK
--==================================================

local function isCharacterModel(model)

    if not model:IsA("Model") then
        return false
    end

    if LocalPlayer.Character
        and model == LocalPlayer.Character then

        return false
    end

    local player =
        Players:GetPlayerFromCharacter(model)

    if player then
        return player ~= LocalPlayer
    end

    local humanoid =
        model:FindFirstChildOfClass("Humanoid")

    if humanoid then
        return true
    end

    return false
end

--==================================================
-- HIDE CHARACTER
--==================================================

local function hideCharacter(character)

    if not hideCharactersEnabled then
        return
    end

    if not isCharacterModel(character) then
        return
    end

    if LocalPlayer.Character
        and character == LocalPlayer.Character then

        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            if object.Name ~= "HumanoidRootPart" then

                rememberObject(object)

                pcall(function()
                    object.LocalTransparencyModifier = 1
                end)

            end

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            rememberObject(object)

            pcall(function()
                object.Transparency = 1
            end)

        elseif object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles") then

            rememberObject(object)

            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("Highlight") then

            rememberObject(object)

            pcall(function()
                object.Enabled = false
            end)

        elseif object:IsA("BillboardGui")
            or object:IsA("SurfaceGui") then

            rememberObject(object)

            pcall(function()
                object.Enabled = false
            end)

        end
    end
end

--==================================================
-- RESTORE CHARACTERS
--==================================================

local function restoreCharacterVisuals()

    for object, data in pairs(
        hiddenCharacterObjects
    ) do

        if object then

            pcall(function()

                if not object.Parent then
                    return
                end

                if data.Type == "BasePart" then

                    object.LocalTransparencyModifier =
                        data.LocalTransparencyModifier or 0

                elseif data.Type == "Transparency" then

                    object.Transparency =
                        data.Transparency or 0

                elseif data.Type == "Enabled" then

                    object.Enabled =
                        data.Enabled

                elseif data.Type == "Highlight" then

                    object.Enabled =
                        data.Enabled

                elseif data.Type == "Gui" then

                    object.Enabled =
                        data.Enabled

                end

            end)

        end
    end

    table.clear(hiddenCharacterObjects)
end

--==================================================
-- FIND ALL CHARACTERS
--==================================================

local function hideAllCharacters()

    if not hideCharactersEnabled then
        return
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.Character then

            hideCharacter(
                player.Character
            )

        end
    end

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("Model") then

            if isCharacterModel(object) then

                hideCharacter(object)

            end

        end
    end
end

