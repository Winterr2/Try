    function()

        if #macroData == 0 then

            StatusLabel.Text =
                "Status: No macro recorded"

            notify(
                "Winter Hub",
                "Record a macro first."
            )

            return
        end

        if isPlaying then

            isPlaying = false

            MacroExecuteButton.Text =
                "MACRO EXECUTE: OFF"

            StatusLabel.Text =
                "Status: Macro stopped"

        else

            MacroExecuteButton.Text =
                "MACRO EXECUTE: ON"

            StatusLabel.Text =
                "Status: Macro executing..."

            executeMacro()

        end

    end
)

--==================================================
-- MINIMIZE
--==================================================

local function setMinimized(state)

    isMinimized = state

    ContentFrame.Visible =
        not state

    if state then

        MainFrame.Size =
            UDim2.fromOffset(230, 36)

        MinimizeButton.Text =
            "+"

    else

        MainFrame.Size =
            UDim2.fromOffset(230, 445)

        MinimizeButton.Text =
            "-"

    end
end

MinimizeButton.MouseButton1Click:Connect(
    function()

        setMinimized(
            not isMinimized
        )

    end
)

--==================================================
-- RIGHT CONTROL
--==================================================

addConnection(
    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if input.KeyCode ==
                minimizeKey then

                setMinimized(
                    not isMinimized
                )

            end

        end
    )
)

--==================================================
-- CLOSE
--==================================================

CloseButton.MouseButton1Click:Connect(
    function()

        isRecording = false
        isPlaying = false

        m1AutoEnabled = false
        m1RapidEnabled = false

        clearMacroConnections()

        restoreCharacterVisuals()

        for _, connection in ipairs(
            winterConnections
        ) do

            pcall(function()
                connection:Disconnect()
            end)

        end

        table.clear(winterConnections)

        _G.WinterHubConnections = {}

        pcall(function()
            ScreenGui:Destroy()
        end)

    end
)

