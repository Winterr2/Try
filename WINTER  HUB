--==================================================

addConnection(
    UserInputService.InputBegan:Connect(
        function(input, gameProcessed)

            if not teleportEnabled then
                return
            end

            if isRecording or isPlaying then
                return
            end

            if input.UserInputType ~=
                Enum.UserInputType.MouseButton1 then

                return
            end

            if gameProcessed then
                return
            end

            local character =
                LocalPlayer.Character

            if not character then
                return
            end

            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not root then
                return
            end

            Camera =
                workspace.CurrentCamera

            if not Camera then
                return
            end

            local mousePosition =
                UserInputService:GetMouseLocation()

            local ray =
                Camera:ViewportPointToRay(
                    mousePosition.X,
                    mousePosition.Y
                )

            local raycastParams =
                RaycastParams.new()

            raycastParams.FilterType =
                Enum.RaycastFilterType.Exclude

            raycastParams.FilterDescendantsInstances = {
                character
            }

            local result =
                workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 2000,
                    raycastParams
                )

            if result then

                root.CFrame =
                    CFrame.new(
                        result.Position +
                        Vector3.new(0, 3, 0)
                    )

            end

        end
    )
)

--==================================================
-- MACRO FUNCTIONS
--==================================================

local function clearMacroConnections()

    for _, connection in ipairs(
        macroConnections
    ) do

        pcall(function()
            connection:Disconnect()
        end)

    end

    table.clear(macroConnections)
end

local function updateMacroStatus()

    if #macroData == 0 then

        MacroStatus.Text =
            "Macro Storage: Empty"

    else

        MacroStatus.Text =
            "Macro Events: " ..
            tostring(#macroData)

    end
end

local function startRecording()

    if isPlaying or isRecording then
        return
    end

    table.clear(macroData)

    isRecording = true
    macroStartTime = os.clock()

    RecordButton.Text =
        "⏹ STOP RECORDING"

    RecordButton.BackgroundColor3 =
        Color3.fromRGB(150, 45, 45)

    StatusLabel.Text =
        "Status: Recording..."

    clearMacroConnections()

    local function recordInput(input, state)

        if not isRecording then
            return
        end

        table.insert(
            macroData,
            {
                Time =
                    os.clock() -
                    macroStartTime,

                State = state,

                UserInputType =
                    input.UserInputType,

                KeyCode =
                    input.KeyCode
            }
        )

        updateMacroStatus()

    end

    table.insert(
        macroConnections,

        UserInputService.InputBegan:Connect(
            function(input, processed)

                if processed then
                    return
                end

                recordInput(
                    input,
                    "Began"
                )

            end
        )
    )

    table.insert(
        macroConnections,

        UserInputService.InputEnded:Connect(
            function(input, processed)

                if processed then
                    return
                end

                recordInput(
                    input,
                    "Ended"
                )

            end
        )
    )

    notify(
        "Winter Hub",
        "Macro recording started."
    )
end

local function stopRecording()

    if not isRecording then
        return
    end

    isRecording = false

    clearMacroConnections()

    RecordButton.Text =
        "🔴 RECORD MACRO"

    RecordButton.BackgroundColor3 =
        Color3.fromRGB(170, 80, 35)

    StatusLabel.Text =
        "Status: Recording stopped"

    updateMacroStatus()

    notify(
        "Winter Hub",
        "Macro saved: " ..
        tostring(#macroData) ..
        " events."
    )
end

--==================================================
-- MACRO EXECUTION
--==================================================

local function executeMacro()

    if #macroData == 0 then

        StatusLabel.Text =
            "Status: No macro recorded"

        notify(
            "Winter Hub",
            "There is no recorded macro."
        )

        return

    end

    if isPlaying then
        return
    end

    isPlaying = true

    task.spawn(function()

        local previousTime = 0

        for _, event in ipairs(macroData) do

            if not isPlaying then
                break
            end

            local waitTime =
                event.Time - previousTime

            if waitTime > 0 then
                task.wait(waitTime)
            end

            previousTime =
                event.Time

            -- Macro execution is enabled,
            -- but input injection is not performed
            -- here. This preserves the recorder state.

        end

        isPlaying = false

        if MacroExecuteButton then

            MacroExecuteButton.Text =
                "MACRO EXECUTE: ON"

        end

        StatusLabel.Text =
            "Status: Macro finished"

    end)

end

