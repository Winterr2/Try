--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

TitleBar.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        dragging = true

        dragStart = input.Position
        startPosition = MainFrame.Position

    end

end)

TitleBar.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        dragging = false

    end

end)

addConnection(
    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType ~=
            Enum.UserInputType.MouseMovement then

            return
        end

        local delta =
            input.Position - dragStart

        MainFrame.Position =
            UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )

    end)
)

--==================================================
-- TELEPORT INPUT
--==================================================

addConnection(
    UserInputService.InputBegan:Connect(function(input, processed)

        if processed then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            -- Do not teleport when clicking the GUI.
            local mousePosition =
                UserInputService:GetMouseLocation()

            local guiObjects =
                PlayerGui:GetGuiObjectsAtPosition(
                    mousePosition.X,
                    mousePosition.Y
                )

            if #guiObjects > 0 then
                return
            end

            teleportToScreenPosition(
                mousePosition
            )
        end

    end)
)

--==================================================
-- MACRO RECORDER
--==================================================

local function clearMacroConnections()

    for _, connection in ipairs(macroConnections) do

        pcall(function()
            connection:Disconnect()
        end)

    end

    table.clear(macroConnections)

end

local function updateMacroStatus()

    local count = #macroData

    if count == 0 then

        MacroStatus.Text =
            "Macro Storage: Empty"

    else

        MacroStatus.Text =
            "Macro Events: " .. tostring(count)

    end

end

local function startRecording()

    if isPlaying then
        return
    end

    if isRecording then
        return
    end

    table.clear(macroData)

    isRecording = true
    macroStartTime = os.clock()

    RecordButton.Text =
        "⏹ STOP RECORDING"

    RecordButton.BackgroundColor3 =
        Color3.fromRGB(150, 45, 45)

    StatusLabel.Text =
        "Status: Recording..."

    clearMacroConnections()

    local function recordInput(input, state)

        if not isRecording then
            return
        end

        local inputType =
            input.UserInputType

        local keyCode =
            input.KeyCode

        table.insert(macroData, {

            Time = os.clock() -
                macroStartTime,

            State = state,

            UserInputType = inputType,

            KeyCode = keyCode,

        })

        updateMacroStatus()

    end

    table.insert(
        macroConnections,

        UserInputService.InputBegan:Connect(
            function(input, processed)

                if processed then
                    return
                end

                recordInput(
                    input,
                    "Began"
                )

            end
        )
    )

    table.insert(
        macroConnections,

        UserInputService.InputEnded:Connect(
            function(input, processed)

                if processed then
                    return
                end

                recordInput(
                    input,
                    "Ended"
                )

            end
        )
    )

    notify(
        "Winter Hub",
        "Macro recording started."
    )

end

local function stopRecording()

    if not isRecording then
        return
    end

    isRecording = false

    clearMacroConnections()

    RecordButton.Text =
        "🔴 RECORD MACRO"

    RecordButton.BackgroundColor3 =
        Color3.fromRGB(170, 80, 35)

    StatusLabel.Text =
        "Status: Recording stopped"

    updateMacroStatus()

    notify(
        "Winter Hub",
        "Macro saved: "
            .. tostring(#macroData)
            .. " events."
    )

end

